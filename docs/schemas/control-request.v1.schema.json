{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDF-005 typed request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "api",
    "factory_id",
    "operation_id",
    "command",
    "capabilities",
    "expected_revision",
    "instance_id",
    "instance_generation",
    "arguments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      }
    },
    "factory_id": {
      "type": "string",
      "pattern": "^fct_[a-f0-9]{32}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z_.]{1,64}$"
      }
    },
    "expected_revision": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "instance_generation": {
      "type": "string"
    },
    "arguments": {
      "type": "object"
    }
  }
}
