{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDF-005 non-authoritative detached launch and reconciliation status",
  "type": "object",
  "required": [
    "schemaVersion",
    "state",
    "factory_id",
    "operation_id"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "api": {
      "type": "object",
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      }
    },
    "state": {
      "enum": [
        "dispatched",
        "existing",
        "submitted",
        "refused"
      ]
    },
    "factory_id": {
      "type": "string",
      "pattern": "^fct_[a-f0-9]{32}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "command": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "instance_generation": {
      "type": "string"
    },
    "accepted": {
      "type": "boolean"
    },
    "reconciliation": {},
    "progress": {
      "type": "object"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
